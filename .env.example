# Yahoo accounts as a JSON array. Each account needs an app password
# generated at https://login.yahoo.com/myaccount/security (NOT your normal password).
# After copying this file to .env, run: chmod 600 .env
YAHOO_ACCOUNTS='[{"name": "personal", "email": "you@yahoo.com", "app_password": "xxxxxxxxxxxxxxxx"}]'

# Optional overrides:
# Path to the SQLite database (default: ~/.yahoo-mail-mcp/mail.db)
#YAHOO_MAIL_MCP_DB=/path/to/mail.db

# Bulk deletes affecting more than this many messages require a confirm token
# from preview_cleanup (default: 1000)
#YAHOO_MAIL_MCP_DELETE_THRESHOLD=1000

# Messages fetched per IMAP round trip during scans (default: 500,
# automatically capped to the server-advertised MESSAGELIMIT)
#YAHOO_MAIL_MCP_BATCH_SIZE=500

# Python log level written to MCP stderr (default: WARNING)
#YAHOO_MAIL_MCP_LOG_LEVEL=WARNING
