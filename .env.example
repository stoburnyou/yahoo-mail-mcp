# Each account needs a Yahoo app password generated at
# https://login.yahoo.com/myaccount/security (NOT your normal password).
# After copying this file to .env, run: chmod 600 .env
YAHOO_ACCOUNT_NAME=personal
YAHOO_EMAIL=you@yahoo.com
YAHOO_APP_PASSWORD=xxxxxxxxxxxxxxxx

# For multiple accounts, comment out the three variables above and use:
#YAHOO_ACCOUNTS='[{"name":"personal","email":"one@yahoo.com","app_password":"xxxxxxxxxxxxxxxx"},{"name":"work","email":"two@yahoo.com","app_password":"xxxxxxxxxxxxxxxx"}]'

# Optional overrides:
# Path to the SQLite database (default: ~/.yahoo-mail-mcp/mail.db)
#YAHOO_MAIL_MCP_DB=/path/to/mail.db

# Archive or Delete moves affecting more than this many messages require a
# confirm token from preview_cleanup (default: 1000)
#YAHOO_MAIL_MCP_DELETE_THRESHOLD=1000

# Messages fetched per IMAP round trip during scans (default: 500,
# automatically capped to the server-advertised MESSAGELIMIT)
#YAHOO_MAIL_MCP_BATCH_SIZE=500

# Python log level written to MCP stderr (default: WARNING)
#YAHOO_MAIL_MCP_LOG_LEVEL=WARNING

# Required only for hosted Streamable HTTP mode. Generate with:
# openssl rand -hex 32
#YAHOO_MAIL_MCP_BEARER_TOKEN=replace-with-at-least-32-random-characters

# Required for hosted mode. Use only the hostname, without https:// or /mcp.
#YAHOO_MAIL_MCP_ALLOWED_HOSTS=mail-mcp.example.com

# Keep enabled behind Railway or another HTTPS reverse proxy.
#YAHOO_MAIL_MCP_REQUIRE_HTTPS=true
